pkgname=calix
pkgver=0.5.1
pkgrel=1
pkgdesc="Native GTK4 calendar for Linux with Google, iCloud, and CalDAV sync"
arch=('x86_64')
url='https://github.com/ianswope/calix'
license=('MIT')
depends=('gtk4' 'libadwaita' 'xdg-utils')
makedepends=('cargo' 'pkgconf')
optdepends=('gnome-keyring: store Google, iCloud, and CalDAV credentials')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
# Release checklist: replace SKIP with the SHA-256 of the immutable tagged
# archive before publishing this PKGBUILD to the AUR.
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  cargo build --release --locked
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 target/release/calix "${pkgdir}/usr/bin/calix"
  install -Dm644 dist/com.ianswope.Calix.desktop \
    "${pkgdir}/usr/share/applications/com.ianswope.Calix.desktop"
  install -Dm644 dist/com.ianswope.Calix.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/com.ianswope.Calix.svg"
  install -Dm644 dist/com.ianswope.Calix.metainfo.xml \
    "${pkgdir}/usr/share/metainfo/com.ianswope.Calix.metainfo.xml"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
